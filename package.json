{
    "name": "mtc-books",
    "private": true,
    "version": "1.0.1",
    "packageManager": "pnpm@10.34.9",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "release": "node scripts/release.mjs",
        "version:set": "node scripts/set-version.mjs",
        "dev:app": "pnpm --parallel --filter @mtc/app --filter @mtc/manual run dev",
        "dev:server": "pnpm --filter @mtc/server dev",
        "dev:manual": "pnpm --filter @mtc/manual dev",
        "typecheck": "pnpm -r --if-present typecheck",
        "build": "pnpm -r --if-present build",
        "check:boundaries": "node scripts/check-boundaries.mjs",
        "dev:desktop": "pnpm --filter @mtc/desktop dev",
        "dist:desktop": "pnpm --filter @mtc/app build && pnpm --filter @mtc/desktop dist",
        "libro-esempio": "pnpm --filter @mtc/app build && pnpm --filter @mtc/desktop exec node scripts/copy-assets.mjs && pnpm --filter @mtc/desktop build && pnpm --filter @mtc/manual libro-esempio",
        "test": "pnpm -r --if-present test"
    }
}
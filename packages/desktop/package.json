{
  "name": "@mtc/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MTC Book Writer, applicazione desktop",
  "author": "MTC Book",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "tsup && electron .",
    "start": "tsup && electron . --dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dist": "tsup && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mtc/shared": "workspace:*"
  }
}
{
  "name": "@mtc/desktop",
  "version": "1.0.1",
  "private": true,
  "description": "MTC Books, applicazione desktop",
  "author": "MTC Books",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && tsup && electron .",
    "start": "pnpm --filter @mtc/app build && node scripts/copy-assets.mjs && tsup && electron . --dist",
    "render:payload": "node scripts/copy-assets.mjs && tsup && electron . --render-payload",
    "probe": "tsup && electron . --engine-probe",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dist": "node scripts/copy-assets.mjs && tsup && electron-builder --win --publish never",
    "release": "node scripts/copy-assets.mjs && tsup && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mtc/pdf-core": "workspace:*",
    "@mtc/shared": "workspace:*"
  }
}